PORT=5000
NODE_ENV=development
# Optional bind address; defaults to loopback in development and all interfaces in production.
HOST=
MONGODB_URI=mongodb://127.0.0.1:27017/dlas
MONGODB_DB=dlas
# Set to the exact deployed Vercel origin, for example https://your-site.vercel.app.
CLIENT_ORIGIN=
# Keep off until fictional staff accounts are seeded with private passwords.
STAFF_LOGIN_ENABLED=false
# admin.com password; development defaults to admin123, production creates no admin without it.
ADMIN_PASSWORD=
# Optional Groq integration. Leave GROQ_API_KEY blank to use deterministic/manual fallbacks.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_TEXT_MODEL=openai/gpt-oss-120b
VOICE_AI=off
DOCUMENT_AI=off
TRIAGE_AI=off
SETTLEMENT_AI=off
# Optional spoken case status (BanglaTTS, demo-only license). Start it with `npm run tts`, then set
# TTS_URL=http://127.0.0.1:5055. Leave blank, or set VOICE_TTS=off, to show the status sentence as text only.
TTS_URL=
VOICE_TTS=
# Referral deadline sweep interval in milliseconds (default 60000).
REFERRAL_SWEEP_MS=
# Required for production identity evidence uploads: a private 32-byte key as 64 hex characters.
# Development generates an ignored server/.identity-evidence-key; keep it to decrypt earlier demo uploads.
IDENTITY_EVIDENCE_KEY=
# Set the authorised retention period explicitly in production (1–365 days); development defaults to 30.
IDENTITY_EVIDENCE_RETENTION_DAYS=
# Install a maintained ffprobe binary on the API host. Blank uses ffprobe from PATH.
FFPROBE_PATH=
