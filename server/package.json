{
  "name": "dlas-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "check:production-static": "node --env-file-if-exists=.env --test src/productionStatic.test.js",
    "seed": "node --env-file-if-exists=.env src/seeds/demoUsers.js",
    "check:voice": "node --env-file-if-exists=.env src/scripts/checkVoiceAi.js",
    "check:voice-status": "node --env-file-if-exists=.env src/scripts/checkVoiceStatus.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "mongoose": "9.10.1"
  }
}
