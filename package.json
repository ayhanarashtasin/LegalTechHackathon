{
  "name": "dlas-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "lint": "eslint client/src server/src",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "build": "npm run build --workspace client",
    "check:voice-bangla": "node --env-file-if-exists=.env server/src/scripts/checkBanglaAudio.js",
    "check:document-ai": "node --env-file-if-exists=.env server/src/scripts/checkDocumentAi.js",
    "check:production-static": "npm run build && npm run check:production-static --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "vitest": "5.0.1"
  }
}
